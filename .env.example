# Supabase project settings (safe to use in the browser with RLS enabled)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key

# Server-only Gemini key. Never prefix this with NEXT_PUBLIC_.
GEMINI_API_KEY=your-gemini-api-key

# Keeps the seeded hackathon experience enabled during the first build.
NEXT_PUBLIC_APP_MODE=demo
